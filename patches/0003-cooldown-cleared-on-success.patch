+  it("clears a self-inflicted cooldown once the request eventually succeeds", async () => {
+    // 本地定制（2026-09-14）：复现线上 503。
+    // 真实链路：一次请求内部先撞上游 5xx（recordFailure 打了 60s cooldown），
+    // 随后内部重试成功、对外返回 200（recordSuccess）。若 recordSuccess 不清掉这层
+    // cooldown，接下来 60 秒内所有请求都会在 select() 处筛出空候选，被秒拒 503
+    // ——09-14 09:10:17/19/24 那三个 503 就是这么来的。
+    const router = new CommandCodeCredentialRouter({
+      credentials: [credential("solo")],
+      policy: "round_robin",
+      billingRefreshMs: 60_000,
+      cooldownMs: 60_000,
+      now: () => now,
+    });
+
+    await router.select({ model: "deepseek/deepseek-v4.1-flash" });
+    router.recordFailure("solo", { statusCode: 502 }); // 内部第一次尝试失败
+    router.recordSuccess("solo"); // 内部重试成功，请求对外返回 200
+
+    await expect(router.select({ model: "deepseek/deepseek-v4.1-flash" })).resolves.toMatchObject({
+      id: "solo",
+    });
+  });
+
+  it("keeps a cooldown recorded by a different request than the one that succeeded", async () => {
+    // 成功的那次请求只应清掉自己造成的 cooldown；不能替别的请求「洗白」。
+    const router = new CommandCodeCredentialRouter({
+      credentials: [credential("a"), credential("b")],
+      policy: "round_robin",
+      billingRefreshMs: 60_000,
+      cooldownMs: 60_000,
+      now: () => now,
+    });
+
+    await router.select({ model: "deepseek/deepseek-v4-pro" });
+    router.recordFailure("a", { statusCode: 429 }); // a 被冷却
+    router.recordSuccess("b"); // b 成功，不应解冻 a
+
+    await expect(router.select({ model: "deepseek/deepseek-v4-pro" })).resolves.toMatchObject({
+      id: "b",
+    });
+  });
+
