+/**
+ * 本地定制（2026-10-29）：候选为空时把「每把 key 为什么不可用」写进 503 的 message。
+ * 旧版只回一句 "No available CommandCode credentials for model X"，且不打日志 ——
+ * 上游 key 作废时整晚静默，只能靠人去翻计费诊断才看得出是 401。
+ */
+function describeUnavailableCredentials(
+  states: CommandCodeCredentialState[],
+  model: string,
+  now: number,
+): string {
+  const parts = states.map((state) => {
+    const reasons: string[] = [];
+    if (state.credential.enabled === false) reasons.push("disabled in config");
+    if (!isModelAllowed(state.credential, model))
+      reasons.push(`model ${model} not in allowedModels`);
+    if (state.disabledUntil > now) {
+      const left = Math.ceil((state.disabledUntil - now) / 1000);
+      reasons.push(`${state.disabledReason ?? "disabled"} for ${left}s more`);
+    }
+    if (state.inFlight > 0) reasons.push(`${state.inFlight} request(s) in flight`);
+    if (hasExceededWindow(state)) reasons.push("usage window exceeded");
+    if (!hasKnownCreditCapacity(state, now)) reasons.push("no remaining credits");
+    if (state.billingError) reasons.push(`last billing error: ${state.billingError}`);
+    return `${state.credential.id}: ${reasons.length > 0 ? reasons.join("; ") : "unavailable"}`;
+  });
+  return parts.join(" | ");
 }
 
