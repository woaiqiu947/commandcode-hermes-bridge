diff --git a/src/credential-router.ts b/src/credential-router.ts
index 05678b8..3d6a3d1 100644
--- a/src/credential-router.ts
+++ b/src/credential-router.ts
@@ -426,6 +426,16 @@ export class CommandCodeCredentialRouter {
   }
 
   public recordSuccess(id: string): void {
+    const state = this.stateById(id);
+    // 本地定制（2026-09-14）：请求最终成功时，清掉它自己在重试途中打下的冷却。
+    // recordFailure 遇 429/无状态码/5xx 会打 cooldownMs 冷却；而同一请求内部重试
+    // 成功后只走 recordSuccess——冷却若残留，接下来整个冷却窗口（默认 60s）内所有
+    // 请求都会在 select() 处筛出空候选并被秒拒 503（09-14 09:10 线上故障即此）。
+    // 只清 "cooldown"：auth/billing/expired 反映凭证的真实问题，一次成功不足以推翻。
+    if (state && state.disabledReason === "cooldown") {
+      state.disabledUntil = 0;
+      state.disabledReason = undefined;
+    }
     this.release(id);
   }
 
