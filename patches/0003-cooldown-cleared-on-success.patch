+
+    // 请求 B：紧接其后，必须仍能选中同一凭证，而不是被 A 残留的 cooldown 拒掉。
+    const second = await client.chat(
+      buildProviderChatRequestBody(
+        { model: "default", messages: [{ role: "user", content: "again" }] },
+        "deepseek/deepseek-v4-pro",
+      ),
+    );
+    expect(second.ok).toBe(true);
+    await expect(second.json()).resolves.toMatchObject({ id: "chatcmpl_3" });
+  });
+
