@@ -0,0 +1,81 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+// 本地定制回归测试（2026-09-18，开关 COMMANDCODE_LEGACY_MODEL_ALIAS）。
+//
+// 生产症状：白名单把 deepseek/deepseek-v4-flash、-flash-fast、-flash-vision-exp 三个旧 ID
+// 淘汰之后，任何"还记着旧 ID"的客户端都会拿到
+//   400 Model "deepseek/deepseek-v4-flash" is not allowed. Allowed models: ...
+// 来源包括：桌面端持久化的模型选择、重命名之前创建、创建时就把模型名钉死的旧会话、
+// 另一台机器、cron 任务。用户看到的现象是"服务又坏了"，而 bridge 本身一切正常。
+//
+// 期望行为：
+//   - 开关关闭（上游默认）→ 旧 ID 一律拒绝，上游行为零变化；
+//   - 开关打开 → 旧 ID 在请求侧归一化到正式 ID，但**不得**重新出现在 /v1/models 里。
+
+const CANONICAL = "deepseek/deepseek-v4.1-flash";
+const LEGACY_IDS = [
+  "deepseek/deepseek-v4-flash",
+  "deepseek-v4-flash",
+  "commandcode/deepseek-v4-flash",
+  "deepseek/deepseek-v4-flash-fast",
+  "deepseek-v4-flash-fast",
+  "commandcode/deepseek-v4-flash-fast",
+  "deepseek/deepseek-v4-flash-vision-exp",
+  "deepseek-v4-flash-vision-exp",
+  "commandcode/deepseek-v4-flash-vision-exp",
+];
+const ALLOWED = `deepseek/deepseek-v4-pro,${CANONICAL},moonshotai/Kimi-K3`;
+
+async function loadConfigModule(legacyAliasEnabled: boolean) {
+  vi.resetModules();
+  if (legacyAliasEnabled) process.env.COMMANDCODE_LEGACY_MODEL_ALIAS = "true";
+  else delete process.env.COMMANDCODE_LEGACY_MODEL_ALIAS;
+  return import("../src/config.js");
+}
+
+afterEach(() => {
+  delete process.env.COMMANDCODE_LEGACY_MODEL_ALIAS;
+});
+
+describe("legacy DeepSeek ids after the allowlist trim", () => {
+  it("keeps rejecting them when the switch is off (upstream behavior unchanged)", async () => {
+    const { loadBridgeConfig, normalizeModelName, resolveModel } = await loadConfigModule(false);
+    const config = loadBridgeConfig({
+      env: { COMMANDCODE_ALLOWED_MODELS: ALLOWED },
+      authPaths: [],
+    });
+
+    // 上游行为：短写法归一化到各自的旧 canonical ID，旧 ID 本身仍然是"不允许"。
+    expect(normalizeModelName("deepseek-v4-flash")).toBe("deepseek/deepseek-v4-flash");
+    expect(normalizeModelName("deepseek/deepseek-v4-flash")).toBe("deepseek/deepseek-v4-flash");
+    for (const id of LEGACY_IDS) {
+      expect(() => resolveModel(id, config), id).toThrow(/not allowed/i);
+    }
+  });
+
+  it("routes every legacy spelling to the canonical id when the switch is on", async () => {
+    const { loadBridgeConfig, normalizeModelName, resolveModel } = await loadConfigModule(true);
+    const config = loadBridgeConfig({
+      env: { COMMANDCODE_ALLOWED_MODELS: ALLOWED },
+      authPaths: [],
+    });
+
+    for (const id of LEGACY_IDS) {
+      expect(normalizeModelName(id), id).toBe(CANONICAL);
+      expect(resolveModel(id, config).upstreamModel, id).toBe(CANONICAL);
+    }
+  });
+
+  it("does not put the legacy ids back into the public model list", async () => {
+    const { loadBridgeConfig, publicModelList } = await loadConfigModule(true);
+    // 故意不开 canonical-only：别名兜底绝不能借"别名枚举"这条路把旧 ID 送回模型列表。
+    const config = loadBridgeConfig({
+      env: { COMMANDCODE_ALLOWED_MODELS: ALLOWED },
+      authPaths: [],
+    });
+    const list = publicModelList(config);
+
+    expect(list).toContain(CANONICAL);
+    for (const id of LEGACY_IDS) expect(list, id).not.toContain(id);
+  });
+});
