-    const stream = Readable.fromWeb(response.body as WebReadableStream<Uint8Array>).pipe(transform);
+    // 本地定制（2026-09-11）：客户端中断流式请求时不能让 bridge 进程退出。
+    // 触发链路：客户端断开 → server.ts 的 reply.raw "close" → signal.abort() → 上游 body
+    // 流以 AbortError 触发 'error'。Node 的 .pipe() 不会把源流错误转发给下游，源流本身又
+    // 没有 'error' 监听者，于是它升级成「未捕获的 error 事件」→ 进程 exit 1（上游 1.53.0.a
+    // 缺陷：实测每次客户端取消流式响应都会崩，2026-09-03 起本机 67 次崩溃全部由此而来）。
+    // 处理原则：客户端已断开（signal 已 abort 或错误为 AbortError）时静默结束下游流；
