+  it("does not block later requests after a request recovers from a transient failure", async () => {
+    // 本地定制（2026-09-14）端到端回归：这正是线上 503 的完整链路。
+    // 单凭证场景下，请求 A 内部先撞 500（router 给凭证打上 cooldown），随后内部重试
